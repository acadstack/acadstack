APP_HOST=localhost
APP_PORT=5300
FREC_PORT=5060
POSTGRES_USER=app_user
POSTGRES_PASSWORD=passw0rd.
POSTGRES_DB=acadstack_db
DB_HOST=db
DB_PORT=5432
UPLOAD_FOLDER="./acadstack_uploads/"

# Dev-only (docker-compose-local.yml): populate demo data on first run
# against an empty ./pgdata volume. See api_service/docker-entrypoint-dev.sh.
AUTO_DEMO_DATA=true

EMAIL_USER="****@gmail.com"
EMAIL_PASSWORD=PASSWORD_HERE
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_DRYRUN=true

# Replace it as per your oauth provider (e.g. Google, Facebook etc.)
OAUTH_CLIENT_ID=SOME_VALUE.apps.googleusercontent.com

# In case your users' OAuth credentials will be mapped to your domain.
# We use it to validate the oauth response data during user authentication.
OAUTH_DOMAIN=YOUR_DOMAIN

# Signs session cookies. REQUIRED in production: if unset, a random key is
# generated at every start, which logs all users out on each restart.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
